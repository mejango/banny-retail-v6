	"metadata": "{\"compiler\":{\"version\":\"0.8.28+commit.7893614a\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[{\"internalType\":\"address\",\"name\":\"hook\",\"type\":\"address\",\"indexed\":true},{\"internalType\":\"address\",\"name\":\"previous\",\"type\":\"address\",\"indexed\":true},{\"internalType\":\"address\",\"name\":\"replacement\",\"type\":\"address\",\"indexed\":true},{\"internalType\":\"bytes32\",\"name\":\"configurationHash\",\"type\":\"bytes32\",\"indexed\":false}],\"type\":\"event\",\"name\":\"Verified\",\"anonymous\":false},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"hook\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"previous\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"replacement\",\"type\":\"address\"},{\"internalType\":\"bytes32\",\"name\":\"previousCodeHash\",\"type\":\"bytes32\"},{\"internalType\":\"bytes32\",\"name\":\"replacementCodeHash\",\"type\":\"bytes32\"},{\"internalType\":\"bytes32\",\"name\":\"expectedConfigurationHash\",\"type\":\"bytes32\"},{\"internalType\":\"uint256\",\"name\":\"expectedMaxTierId\",\"type\":\"uint256\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\",\"name\":\"check\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"hook\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"resolver\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"maxTierId\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\",\"name\":\"configurationHash\",\"outputs\":[{\"internalType\":\"bytes32\",\"name\":\"digest\",\"type\":\"bytes32\"}]}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{\"check(address,address,address,bytes32,bytes32,bytes32,uint256)\":{\"details\":\"Requires the calling Safe to own both resolvers. Zero supply, burns and resolver custody establish the unminted switch window; executing the switch in the same batch prevents state changes between checks and activation.\",\"params\":{\"expectedConfigurationHash\":\"The configuration commitment both resolvers must match.\",\"expectedMaxTierId\":\"The greatest configured product tier ID.\",\"hook\":\"The collection whose resolver is being switched.\",\"previous\":\"The resolver expected to be active on the collection.\",\"previousCodeHash\":\"The expected runtime code hash of the current resolver.\",\"replacement\":\"The resolver proposed for the collection.\",\"replacementCodeHash\":\"The expected runtime code hash of the proposed resolver.\"}},\"configurationHash(address,address,uint256)\":{\"details\":\"Excludes published SVG bytes so permissionless publication of correctly committed artwork cannot block a switch.\",\"params\":{\"hook\":\"The collection whose product names are included.\",\"maxTierId\":\"The greatest product tier ID included in the commitment.\",\"resolver\":\"The resolver whose configuration is committed.\"},\"returns\":{\"digest\":\"The ordered configuration commitment.\"}}},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"check(address,address,address,bytes32,bytes32,bytes32,uint256)\":{\"notice\":\"Checks that switching the collection's resolver preserves its committed configuration before minting.\"},\"configurationHash(address,address,uint256)\":{\"notice\":\"Computes the commitment to a resolver's metadata, artwork templates, product names and SVG hashes.\"}},\"version\":1}},\"settings\":{\"remappings\":[\"@arbitrum/=node_modules/@arbitrum/\",\"@bananapus/=node_modules/@bananapus/\",\"@chainlink/=node_modules/@chainlink/\",\"@croptop/=node_modules/@croptop/\",\"@eth-optimism/=node_modules/@eth-optimism/\",\"@offchainlabs/=node_modules/@offchainlabs/\",\"@openzeppelin/=node_modules/@openzeppelin/\",\"@prb/=node_modules/@prb/\",\"@rev-net/=node_modules/@rev-net/\",\"@scroll-tech/=node_modules/@chainlink/contracts/node_modules/@scroll-tech/\",\"@sphinx-labs/=node_modules/@sphinx-labs/\",\"@uniswap/=node_modules/@uniswap/\",\"@zksync/=node_modules/@zksync/\",\"base64-sol/=node_module